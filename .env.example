PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated browser origins allowed to call the API.
# Replace the production example with the exact URL assigned by Vercel.
CLIENT_ORIGIN=http://localhost:3000,https://your-vercel-project.vercel.app

# Optional: register free developer credentials at https://developer.adzuna.com
# Remotive live jobs work without credentials; Adzuna adds current India listings.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
